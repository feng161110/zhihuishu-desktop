{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZhihuishuDesk",
  "version": "1.3.3",
  "identifier": "com.zhihuishu.desk",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5183",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "智慧树学习助手",
        "width": 1300,
        "height": 860,
        "minWidth": 1080,
        "minHeight": 720,
        "center": true,
        "resizable": true,
        "decorations": false,
        "shadow": true,
        "theme": "Light",
        "backgroundColor": "#F4F1EA",
        "backgroundThrottling": "disabled",
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../../backend/bin/zhs-backend": "backend/bin/zhs-backend"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg4QkVGM0Y4OTk3QzlENkIKUldScm5YeVorUE8raU9zd01Kckx2b3N0b1RRa0drOHRSN3VWUWhzaTBsUDZJeGtBVENheER4TWMK",
      "endpoints": [
        "https://github.com/feng161110/zhihuishu-desktop/releases/latest/download/latest.json"
      ]
    }
  }
}
